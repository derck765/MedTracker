rules_version = '2';

// Deploy: Firebase Console → Firestore Database → Rules, or from project root:
//   firebase deploy --only firestore:rules
//
// Users may only read/write their own profile document. Passwords never touch Firestore (Firebase Auth only).

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
